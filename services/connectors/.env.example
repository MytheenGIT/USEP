# Copy to .env (never commit .env). Values below are placeholders.

# Required: the service will not start without these two.
# uuid:   python3 -c "import uuid; print(uuid.uuid4())"
USEP_INGESTION_TENANT_ID=
# DEVELOPMENT ONLY key-encryption key, until Vault or KMS is chosen (open item O-04).
# 32 random bytes, base64:  python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Losing this key makes every stored raw object unreadable, so keep a copy for as long as the data matters.
USEP_INGESTION_DEV_KEK_B64=

# Where raw objects land (encrypted): "file" = a folder under output/ in this repo, for checking now; "s3" = the bucket.
USEP_INGESTION_RAW_STORE=file
# Only for USEP_INGESTION_RAW_STORE=s3. The bucket must already exist (block public access, versioning and Object Lock
# on, server-side encryption); the service refuses to start if it cannot use it. On AWS use a role and leave the keys out.
USEP_INGESTION_S3_BUCKET=
USEP_INGESTION_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Readable per-run JSON under output/ (unencrypted; turn off before real data).
USEP_INGESTION_JSON_SINK_ENABLED=true

# Admin console (the UI). With no admin credentials set, nobody can sign in. Use a long random password.
USEP_INGESTION_ADMIN_USERNAME=
USEP_INGESTION_ADMIN_PASSWORD=
# SSH keys typed into the console (GitHub and GitLab). SSH access is refused unless the server knows the hosts' keys:
# put the known_hosts lines here (ssh-keyscan output you have checked against the host's published fingerprints), or a file path.
# github.com and gitlab.com need nothing here (their published host keys are built in). Add lines only for a self-hosted GitLab or GitHub Enterprise.
USEP_INGESTION_SSH_KNOWN_HOSTS=
USEP_INGESTION_SSH_KNOWN_HOSTS_FILE=
# Hosts typed into the console: private or internal addresses are refused unless true (an on-prem Jira or GitLab).
USEP_INGESTION_ALLOW_PRIVATE_SOURCE_HOSTS=false

# Token every /sync, /results and /sources call must send as "Authorization: Bearer <token>".
USEP_INGESTION_API_TOKEN=

# Sources. Every source is optional: set <SOURCE>_ENABLED=true only for the ones you have. A selected source must be
# complete, or the service refuses to start. Tokens stay here for now; Vault references are open item O-18.
# Lists can be comma-separated (ENG,OPS) or JSON.

# --- Azure DevOps: needs BASE_URL, PAT and PROJECT_NAMES
USEP_INGESTION_ADO_ENABLED=false
USEP_INGESTION_ADO_BASE_URL=https://dev.azure.com/myorganization
USEP_INGESTION_ADO_PAT=
# Project names to read (one per line or JSON list)
USEP_INGESTION_ADO_PROJECT_NAMES=

# --- Jira: needs BASE_URL, EMAIL, API_TOKEN and at least one of PROJECT_KEYS, JQL_QUERIES, JQL
USEP_INGESTION_JIRA_ENABLED=false
USEP_INGESTION_JIRA_BASE_URL=
USEP_INGESTION_JIRA_EMAIL=
USEP_INGESTION_JIRA_API_TOKEN=
# Each key reads that whole project; several keys are several scopes.
USEP_INGESTION_JIRA_PROJECT_KEYS=
# Your own JQL, one query per line (or a JSON list). Leave out the cursor; the service adds it.
USEP_INGESTION_JIRA_JQL_QUERIES=

# --- Confluence: needs BASE_URL, EMAIL, API_TOKEN and SPACE_KEYS
USEP_INGESTION_CONFLUENCE_ENABLED=false
USEP_INGESTION_CONFLUENCE_BASE_URL=
USEP_INGESTION_CONFLUENCE_EMAIL=
USEP_INGESTION_CONFLUENCE_API_TOKEN=
USEP_INGESTION_CONFLUENCE_SPACE_KEYS=

# --- GitLab: needs PRIVATE_TOKEN and PROJECT_IDS and/or ALL_MEMBER_PROJECTS=true
USEP_INGESTION_GITLAB_ENABLED=false
USEP_INGESTION_GITLAB_BASE_URL=https://gitlab.com
USEP_INGESTION_GITLAB_PRIVATE_TOKEN=
# Project ids, group/project paths or repository URLs.
USEP_INGESTION_GITLAB_PROJECT_IDS=
# Also read every repository the token's user is a member of (can include repositories nobody approved).
USEP_INGESTION_GITLAB_ALL_MEMBER_PROJECTS=false

# --- GitHub: needs TOKEN and REPOSITORIES and/or ALL_MEMBER_PROJECTS=true
USEP_INGESTION_GITHUB_ENABLED=false
# https://api.github.com, or https://<host>/api/v3 for GitHub Enterprise.
USEP_INGESTION_GITHUB_BASE_URL=https://api.github.com
USEP_INGESTION_GITHUB_TOKEN=
# owner/repo, links, or SSH links (git@github.com:owner/repo.git).
USEP_INGESTION_GITHUB_REPOSITORIES=
# Also read every repository the token's user can reach (can include repositories nobody approved).
USEP_INGESTION_GITHUB_ALL_MEMBER_PROJECTS=false

# --- ServiceNow: needs BASE_URL, USERNAME, PASSWORD and TABLES
USEP_INGESTION_SERVICENOW_ENABLED=false
USEP_INGESTION_SERVICENOW_BASE_URL=
USEP_INGESTION_SERVICENOW_USERNAME=
USEP_INGESTION_SERVICENOW_PASSWORD=
# Each table is its own scope: incident, change_request, problem, ...
USEP_INGESTION_SERVICENOW_TABLES=
# Optional encoded query that narrows every table, for example active=true^priority<=2
USEP_INGESTION_SERVICENOW_QUERY=

# --- Figma: needs ACCESS_TOKEN and FILE_KEYS, and stays off until the DPIA is signed off (ADR-025, O-05)
USEP_INGESTION_FIGMA_ENABLED=false
USEP_INGESTION_FIGMA_ACCESS_TOKEN=
USEP_INGESTION_FIGMA_FILE_KEYS=
USEP_INGESTION_FIGMA_DPIA_APPROVED=false

# Scheduler: set to false to run only when you call POST /sync/<source>.
USEP_INGESTION_SCHEDULER_ENABLED=false

# Audit trail: file (default, JSON lines under output/audit, hash-chained), postgres (audit_event table) or s3 (one object per event).
USEP_INGESTION_AUDIT_STORE=file
USEP_INGESTION_AUDIT_DIR=
