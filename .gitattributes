# Normalise line endings so signed packs and canonical hashes are stable across platforms.
* text=auto eol=lf

*.yml   text eol=lf
*.yaml  text eol=lf
*.ttl   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.rego  text eol=lf
*.tf    text eol=lf
*.sh    text eol=lf
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.gif   binary
